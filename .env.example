# --- API LLM (renseigne au moins une, idéalement les deux pour le fallback) ---
GEMINI_API_KEY=your_gemini_api_key_here
GROK_API_KEY=your_grok_api_key_here

# --- Configuration SMTP pour l'envoi d'e-mails ---
# Avec Gmail : utilise un "mot de passe d'application", jamais ton mot de passe principal
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# --- Configuration du module de surveillance ---
FORCE_N_BASE_URL=https://force-n.sn
UPDATE_CHECK_INTERVAL_HOURS=24

# --- Chemins de stockage ---
CHROMA_DB_PATH=./chroma_db
DATA_PATH=./data
